# Copy to .env and set your own key. Never commit .env.
DEEPSEEK_API_KEY=
DAYU_PORT=4318
# Optional; otherwise generated in .data/api-token.
# DAYU_API_TOKEN=at-least-24-random-characters
# DAYU_DATA_DIR=C:\path\dayu-data
# DAYU_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional absolute executable paths; normally detected automatically.
# CODEX_PATH=C:\path\codex.exe
# CLAUDE_PATH=C:\path\claude.exe
