{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "electron", "vite.config.ts", "../shared/types.ts"]
}
