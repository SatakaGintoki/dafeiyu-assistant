  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Executor": {
        "type": "string",
        "enum": [
          "codex",
          "claude",
          "zcode",
          "demo"
        ]
      },
      "TaskStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "cancelling",
          "succeeded",
          "failed",
          "cancelled",
          "interrupted"
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "CreateTask": {
        "type": "object",
        "required": [
          "title",
          "instruction"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24000
          },
          "executor": {
            "$ref": "#/components/schemas/Executor"
          },
          "model": {
            "type": "string",
            "maxLength": 120
          },
          "workspace": {
            "type": "string",
            "description": "默认使用设置的工作目录，显式目录必须在其内部"
          },
          "parentId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Task": {
        "type": "object",
        "required": [
          "id",
          "title",
          "instruction",
          "executor",
          "model",
          "workspace",
          "status",
          "createdAt",
          "updatedAt",
          "result",
          "error",
          "logs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "executor": {
            "$ref": "#/components/schemas/Executor"
          },
          "model": {
            "type": "string"
          },
          "workspace": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "logs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "parentId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant",
              "system"
            ]
          },
          "content": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "taskId": {
            "type": "string"
          }
        }
      },
      "Settings": {
        "type": "object",
        "properties": {
          "runtime": {
            "type": "string",
            "enum": [
              "harness",
              "deepseek",
              "demo"
            ]
          },
          "model": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string",
            "format": "uri"
          },
          "defaultExecutor": {
            "$ref": "#/components/schemas/Executor"
          },
          "workspace": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "codexPath": {
            "type": "string"
          },
          "claudePath": {
            "type": "string"
          },
          "zcodePath": {
            "type": "string"
          },
          "executorModel": {
            "type": "string"
          },
          "taskTimeoutMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 240
          },
          "hasApiKey": {
            "type": "boolean",
            "readOnly": true
          }
        }
      },
      "ExecutorInfo": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Executor"
          },
          "name": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Preference": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "data": {},
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "State": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "executors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExecutorInfo"
            }
          },
          "busy": {
            "type": "boolean"
          },
          "petState": {
            "enum": [
              "idle",
              "thinking",
              "working",
              "waiting"
            ]
          }
        }
      }
    }
  }
}
