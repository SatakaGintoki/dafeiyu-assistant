      },
      "patch": {
        "summary": "更新设置；工作期间返回 409",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "runtime": {
                    "type": "string",
                    "enum": [
                      "harness",
                      "deepseek",
                      "demo"
                    ]
                  },
                  "model": {
                    "type": "string"
                  },
                  "baseUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "defaultExecutor": {
                    "$ref": "#/components/schemas/Executor"
                  },
                  "workspace": {
                    "type": "string"
                  },
                  "nickname": {
                    "type": "string"
                  },
                  "codexPath": {
                    "type": "string"
                  },
                  "claudePath": {
                    "type": "string"
                  },
                  "zcodePath": {
                    "type": "string"
                  },
                  "executorModel": {
                    "type": "string"
                  },
                  "taskTimeoutMinutes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 240
                  },
                  "apiKey": {
                    "type": "string",
                    "writeOnly": true,
                    "description": "省略则保持原值，空字符串清除。使用 .env 时应同时清除环境变量。"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新后的设置",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "来源或目录不允许",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
